==== before keys 1, after 883 bytes ====
#include <stdio.h>

/* Legends never die. */
static int race(int laps) {
    int total = 0;
    for (int lap = 1; lap <= laps; lap++) {
        total += lap * 999;
    }
    return total;
}

int main(void) {
    printf("%d\n", race(3));
    return 0;
}
