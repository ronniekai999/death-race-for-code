<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The legendsd spike's LaunchAgent (docs/SPIKE.md), embedded only by SPIKE=1 scripts/bundle.sh.
  Registered with SMAppService from the Debug menu. No RunAtLoad and no KeepAlive: it runs
  only when kickstarted, probes, and exits.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.deathraceforcode.legendsd-spike</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/legendsd-spike</string>
	<key>ProgramArguments</key>
	<array>
		<string>legendsd-spike</string>
		<string>--probe</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>local.deathraceforcode.DeathRace</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
