  3 /* Legends never die. */
  4 static int race(int laps) {
  5     int total = 0;
  6     for (int lap = 1; lap <= laps; lap++) {
  7         total += lap * 999;
  8     }
  9     return total;
 10 }
 11
 12 int main(void) {
 13     printf("%d\n", race(3));
 14     return 0;
